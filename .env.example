# 复制为 .env；数据库密码请改为随机密码，使用字母和数字以避免 URL 编码问题。
POSTGRES_USER=couple
POSTGRES_PASSWORD=replaceWithARandomLongPassword
POSTGRES_DB=couple
APP_URL=http://localhost:33442
APP_PORT=33442
BIND_ADDRESS=127.0.0.1
PORT=33442
COOKIE_SECURE=false
# 本地开发连接（Compose 中会自动覆盖为 db 服务地址）
DATABASE_URL=postgresql://couple:couple_local_only@127.0.0.1:55432/couple
# 公网 HTTPS 部署时 APP_URL=https://你的域名，COOKIE_SECURE=true
# 手机局域网测试：BIND_ADDRESS=0.0.0.0，APP_URL=http://电脑局域网IP:33442。
# Vite本地开发：APP_URL=http://localhost:5173，所有写请求会校验此来源。

# 留空仍可使用任务、积分、小店和站内通知。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 北辰聚合登录（可选）。凭据只在后端使用，不要放进前端代码。
WECHAT_LOGIN_ENABLED=false
BEICHEN_APP_ID=
BEICHEN_APP_KEY=
