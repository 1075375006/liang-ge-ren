# 生产配置模板：deploy.sh 首次运行会自动复制并补齐随机数据库密码；不要提交 production.env。
# scripts/deploy.sh --init 会在首次部署时从本模板创建 production.env，已有文件不会覆盖。
# 若配置文件放在其他位置，可设置 DEPLOY_ENV_FILE=/绝对路径/production.env。

# 可选：反代后的公开 origin，用于验证/找回邮件链接；留空时使用应用本机地址。
APP_URL=
# 应用仅供同机反代访问；异机/容器反代时改为具体内网 IP 或 0.0.0.0，并用防火墙限制来源。
BIND_ADDRESS=127.0.0.1
APP_PORT=33442
COOKIE_SECURE=true
# 只填写反向代理的可信来源（CIDR、loopback、linklocal、uniquelocal 等），代理必须覆盖传入的 X-Forwarded-*。
TRUST_PROXY=loopback,linklocal,uniquelocal

POSTGRES_USER=couple
POSTGRES_DB=couple
# 首次部署可留空，scripts/deploy.sh 会生成随机密码；已有数据库卷不得留空或更换此值。
POSTGRES_PASSWORD=

SUPPORT_EMAIL=
OPERATOR_NAME=两个人
REQUIRE_VERIFIED_EMAIL=true
REGISTRATION_OPEN=true

# 邮箱和微信在 /admin 后台设置，不写进 production.env。

LOG_LEVEL=info
APP_VERSION=production

# 备份与状态目录默认位于项目的 .local/production；可按需改成绝对路径。
DEPLOY_STATE_DIR=.local/production
BACKUP_DIR=.local/production/backups
BACKUP_RETENTION_DAYS=14
COMPOSE_PROJECT_NAME=liang-ge-ren-production
APP_IMAGE=liang-ge-ren:pending
APP_VERSION=pending
